<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    tools:context=".Beranda.BerandaFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/emas_koin"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:titleTextColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <View
                android:id="@+id/background_header"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_header_wave"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textHalo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="24dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Halo"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="@string/tagline"
                android:textColor="@color/krem"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textHalo" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSaldo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/hijau_pelepah"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textTagline">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/textLabelSaldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:text="@string/label_saldo"
                        android:textColor="@color/krem"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textSaldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:text="@string/isi_saldo"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textLabelSaldo" />

                    <TextView
                        android:id="@+id/textKetSaldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/ket_saldo"
                        android:textColor="@color/emas_koin"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textSaldo" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textLabelMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/label_menu_cepat"
                android:textColor="@color/hijau_pelepah"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardSaldo" />

            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/gridMenuCepat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                app:columnCount="2"
                app:useDefaultMargins="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textLabelMenu">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuKantong"
                    android:layout_height="64dp"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="@string/menu_kantong"
                    android:textAllCaps="false"
                    android:textColor="@color/hijau_pelepah"
                    android:textSize="14sp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_kantong"
                    app:iconGravity="textStart"
                    app:iconTint="@color/emas_koin"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:strokeColor="@color/krem_kartu"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuTransaksi"
                    android:layout_height="64dp"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="@string/menu_transaksi"
                    android:textAllCaps="false"
                    android:textColor="@color/hijau_pelepah"
                    android:textSize="14sp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_transaksi"
                    app:iconGravity="textStart"
                    app:iconTint="@color/emas_koin"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:strokeColor="@color/krem_kartu"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuHarga"
                    android:layout_height="64dp"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="@string/menu_harga"
                    android:textAllCaps="false"
                    android:textColor="@color/hijau_pelepah"
                    android:textSize="14sp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_harga"
                    app:iconGravity="textStart"
                    app:iconTint="@color/emas_koin"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:strokeColor="@color/krem_kartu"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBagikan"
                    android:layout_height="64dp"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="@string/tombol_bagikan_pendek"
                    android:textAllCaps="false"
                    android:textColor="@color/hijau_pelepah"
                    android:textSize="14sp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconTint="@color/emas_koin"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:strokeColor="@color/krem_kartu"
                    app:strokeWidth="1dp" />

            </androidx.gridlayout.widget.GridLayout>

            <TextView
                android:id="@+id/textLabelTips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/label_tips"
                android:textColor="@color/hijau_pelepah"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/gridMenuCepat" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textLabelTips" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

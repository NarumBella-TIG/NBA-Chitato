<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingVertical="14dp">

    <ImageView
        android:id="@+id/imgFoto"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Foto pihak transaksi"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textJudul"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="Judul transaksi"
        android:textColor="@color/hijau_pelepah"
        android:textSize="15sp"
        app:layout_constraintEnd_toStartOf="@id/textNominal"
        app:layout_constraintStart_toEndOf="@id/imgFoto"
        app:layout_constraintTop_toTopOf="@id/imgFoto" />

    <TextView
        android:id="@+id/textKeterangan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/plus_jakarta_sans_regular"
        android:text="Tanggal dan pihak"
        android:textColor="@color/abu_teks"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/textJudul"
        app:layout_constraintStart_toStartOf="@id/textJudul"
        app:layout_constraintTop_toBottomOf="@id/textJudul" />

    <TextView
        android:id="@+id/textNominal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="Rp0"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    tools:context=".Transaksi.TransaksiFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/emas_koin"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:titleTextColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textLabelKategori"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="@string/label_catat"
        android:textColor="@color/hijau_pelepah"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridKategori"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        app:columnCount="2"
        app:useDefaultMargins="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textLabelKategori">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJualTbs"
            android:layout_height="56dp"
            android:backgroundTint="@color/white"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/kategori_jual_tbs"
            android:textColor="@color/hijau_pelepah"
            app:cornerRadius="16dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal"
            app:strokeColor="@color/krem_kartu"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPupuk"
            android:layout_height="56dp"
            android:backgroundTint="@color/white"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/kategori_pupuk"
            android:textColor="@color/hijau_pelepah"
            app:cornerRadius="16dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal"
            app:strokeColor="@color/krem_kartu"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpah"
            android:layout_height="56dp"
            android:backgroundTint="@color/white"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/kategori_upah"
            android:textColor="@color/hijau_pelepah"
            app:cornerRadius="16dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal"
            app:strokeColor="@color/krem_kartu"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlat"
            android:layout_height="56dp"
            android:backgroundTint="@color/white"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/kategori_alat"
            android:textColor="@color/hijau_pelepah"
            app:cornerRadius="16dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal"
            app:strokeColor="@color/krem_kartu"
            app:strokeWidth="1dp" />

    </androidx.gridlayout.widget.GridLayout>

    <TextView
        android:id="@+id/textLabelRiwayat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="@string/label_riwayat"
        android:textColor="@color/hijau_pelepah"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gridKategori" />

    <ListView
        android:id="@+id/listTransaksi"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@color/white"
        android:divider="@color/krem_kartu"
        android:dividerHeight="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textLabelRiwayat" />

</androidx.constraintlayout.widget.ConstraintLayout>
